{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HolyPop",
  "version": "0.1.0",
  "identifier": "com.holypop.app",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "HolyPop", "width": 800, "height": 600, "maxWidth": 800, "maxHeight": 600, "minWidth": 600, "minHeight": 480, "maximizable": false },
      { "label": "overlay", "title": "HolyPop Overlay", "url": "overlay.html", "visible": false, "transparent": true, "decorations": false, "alwaysOnTop": true, "skipTaskbar": true, "focus": false, "focusable": false, "resizable": false, "shadow": false }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"] }
}
